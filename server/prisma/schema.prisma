generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  googleSub String   @unique @map("google_sub")
  email     String   @unique
  name      String
  avatar    String?
  username  String?  @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}